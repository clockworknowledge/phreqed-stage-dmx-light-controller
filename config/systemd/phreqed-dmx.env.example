# Phreqed headless show-controller settings.
# Installed as /etc/default/phreqed-dmx by scripts/pi-install-show-service.sh.
# Keep the safe ceilings unless the exact rig has completed stepped validation.

PHREQED_HOST=0.0.0.0
PHREQED_PORT=8080
# Comma-separated trusted control networks. The second subnet is reserved for
# a dedicated show router or a future Pi-hosted access point.
PHREQED_ALLOW_NETWORK=192.168.1.0/24,10.42.0.0/24

PHREQED_AUDIO_DEVICE=plughw:CARD=Snowball,DEV=0
PHREQED_AUDIO_SENSITIVITY=12
PHREQED_AUDIO_AUTO_LEVEL=1
# Keep the browser available if the microphone was not connected before boot.
PHREQED_AUDIO_REQUIRED=0

# Installed by config/udev/70-phreqed-ampero.rules and independent of ALSA's
# numeric card assignment.
PHREQED_FOOT_MIDI_DEVICE=/dev/snd/phreqed-ampero-midi
PHREQED_FOOT_MIDI_CHANNEL=1

# Safe default: browser control exposes Rehearsal power only.
PHREQED_RGB_CEILING=0.65
PHREQED_ACKNOWLEDGE_HIGH_OUTPUT=0
# After stepped validation of the exact show rig, setting the two values above
# to 1.0 and 1 exposes the separately confirmed Show power profile. Startup,
# live activation, and every live stop still use the 0.65 Rehearsal profile.
PHREQED_WHITE_CEILING=0.10
PHREQED_ACKNOWLEDGE_HIGH_OUTPUT_WHITES=0
