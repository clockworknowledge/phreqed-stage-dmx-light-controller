# Phreqed headless show-controller settings.
# Installed as /etc/default/phreqed-dmx by scripts/pi-install-show-service.sh.
# Keep the safe ceilings unless the exact rig has completed stepped validation.

PHREQED_HOST=0.0.0.0
PHREQED_PORT=8080
# Safe default: browser OS shutdown is unavailable until explicitly enabled.
PHREQED_ALLOW_SYSTEM_SHUTDOWN=0
# Safe default: network and physical backlight mutation are hidden until the
# commissioned local kiosk helper units are installed and explicitly enabled.
PHREQED_ALLOW_LOCAL_OPERATIONS=0
# Required only when the local Wi-Fi action is enabled and more than one saved
# client profile exists. This is a NetworkManager connection name, not a key.
PHREQED_WIFI_CONNECTION=
# Comma-separated trusted control networks. The second subnet is reserved for
# a dedicated show router or a future Pi-hosted access point.
PHREQED_ALLOW_NETWORK=192.168.1.0/24,10.42.0.0/24

PHREQED_AUDIO_DEVICE=plughw:CARD=Snowball,DEV=0
PHREQED_AUDIO_SENSITIVITY=12
PHREQED_AUDIO_AUTO_LEVEL=1
# Keep the browser available if the microphone was not connected before boot.
PHREQED_AUDIO_REQUIRED=0

# Installed by config/udev/70-phreqed-ampero.rules and independent of ALSA's
# numeric card assignment.
PHREQED_FOOT_MIDI_DEVICE=/dev/snd/phreqed-ampero-midi
PHREQED_FOOT_MIDI_CHANNEL=1

# Optional Stage Video lane. It stays disabled unless the exact package,
# published video-show.json sidecar, Wayland session, and projector screen have
# completed commissioning. Lighting remains available when this is disabled.
PHREQED_VIDEO_OUTPUT=0
PHREQED_VIDEO_PACKAGES=/home/mmorley/.local/share/phreqed-dmx/video-packages
PHREQED_VIDEO_LIBRARY=/home/mmorley/.local/share/phreqed-dmx/video-show.json
PHREQED_VIDEO_SCREEN=1
PHREQED_VIDEO_SURFACE=portrait-character
PHREQED_VLC_EXECUTABLE=vlc

# Safe default: browser control exposes Rehearsal power only.
PHREQED_RGB_CEILING=0.65
PHREQED_ACKNOWLEDGE_HIGH_OUTPUT=0
# After stepped validation of the exact show rig, a higher RGB ceiling plus an
# acknowledgement exposes the separately confirmed RGB Show power profile.
# Startup, live activation, and every live stop still use RGB Rehearsal power.
PHREQED_WHITE_CEILING=0.10
PHREQED_ACKNOWLEDGE_HIGH_OUTPUT_WHITES=0
# To expose the full commissioned white range, set PHREQED_WHITE_CEILING=1.0
# and PHREQED_ACKNOWLEDGE_HIGH_OUTPUT_WHITES=1. Startup, live activation, and
# every live stop still use White Rehearsal power and leave whites disarmed.
